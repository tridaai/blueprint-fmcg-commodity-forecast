# --- Model port profiles (lead) ------------------------------------
# offline (default): deterministic composer, no key, no network —
# tests, evals and the demo run on it.
# Hosted profiles are FAIL-CLOSED: selecting one without its
# configuration is an error at startup, never a silent fall back.
FMCG_MODEL_PROFILE=offline

# anthropic profile:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# bedrock profile:
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5
# AWS_REGION=us-east-1

# nim profile (self-hosted NVIDIA NIM endpoint):
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_API_KEY=nvapi-...
# NIM_MODEL=meta/llama-3.3-70b-instruct

# --- Stores ----------------------------------------------------------
# SQLite local default:
FMCG_SQLITE_PATH=./data/fmcg.db
# PostgreSQL 16 (production store) — set to switch the store port:
# DATABASE_URL=<redacted>

# --- Dataset ---------------------------------------------------------
# The generator seed. Changing it plants a different (still fully
# manifested) dataset.
FMCG_DATASET_SEED=20261027

# --- API ---------------------------------------------------------------
FMCG_PORT=8000
